DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_TOKEN_EXPIRE_MINUTES=60
PUBLIC_BASE_URL=https://your-appsail-domain.example.com
CORS_ORIGINS=https://your-mobile-web-origin.example.com
MAX_IMAGE_SIZE_MB=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
AWS_ENDPOINT_URL_S3=https://your-s3-compatible-storage.example.com
NEON_STORAGE_BUCKET=your-bucket-name
AWS_REGION=your-storage-region
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
OTP_SECRET_SALT=replace-with-a-different-32-byte-random-secret
TWOFACTOR_API_KEY=your-2factor-api-key
ENVIRONMENT=production
PHONE_OTP_ENABLED=false
